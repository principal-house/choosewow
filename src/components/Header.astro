---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo">Choose WOW</a>
		<div class="nav-links">
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/subscribe">Subscribe</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(13, 13, 11, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 720px;
		margin: 0 auto;
		padding: 0 1em;
		height: 56px;
	}
	.logo {
		font-size: 0.95em;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.logo:hover { color: var(--accent); }
	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}
	.nav-links a {
		font-size: 0.88em;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.15s ease;
	}
	.nav-links a:hover, .nav-links a.active {
		color: var(--text);
	}
</style>
