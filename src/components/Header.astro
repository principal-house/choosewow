---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo"><svg class="sparkle" viewBox="0 0 16 16" width="14" height="14" fill="#c99a2e"><path d="M8 0 L9.2 6 L8 7.5 L6.8 6Z"/><path d="M8 16 L6.8 10 L8 8.5 L9.2 10Z"/><path d="M0 8 L6 6.8 L7.5 8 L6 9.2Z"/><path d="M16 8 L10 9.2 L8.5 8 L10 6.8Z"/></svg> Choose WOW</a>
		<div class="nav-links">
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/subscribe">Subscribe</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(250, 248, 243, 0.9);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 720px;
		margin: 0 auto;
		padding: 0 1em;
		height: 56px;
	}
	.logo {
		font-size: 0.95em;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.logo:hover { color: var(--accent); }
	.sparkle { margin-right: 0.25em; vertical-align: -1px; }
	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}
	.nav-links a {
		font-size: 0.88em;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.15s ease;
	}
	.nav-links a:hover, .nav-links a.active {
		color: var(--text);
	}
</style>
