---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo"><svg class="sparkle" viewBox="0 0 16 16" width="14" height="14" fill="#c99a2e"><path d="M8 0 L9.2 6 L8 7.5 L6.8 6Z"/><path d="M8 16 L6.8 10 L8 8.5 L9.2 10Z"/><path d="M0 8 L6 6.8 L7.5 8 L6 9.2Z"/><path d="M16 8 L10 9.2 L8.5 8 L10 6.8Z"/></svg> Choose WOW</a>
		<div class="nav-links">
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/subscribe">Subscribe</HeaderLink>
			<a href="https://www.linkedin.com/in/janisr/" target="_blank" aria-label="LinkedIn" class="social">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(250, 248, 243, 0.9);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 720px;
		margin: 0 auto;
		padding: 0 1em;
		height: 56px;
	}
	.logo {
		font-size: 0.95em;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
		letter-spacing: -0.02em;
	}
	.logo:hover { color: var(--accent); }
	.sparkle { margin-right: 0.25em; vertical-align: -1px; }
	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.5em;
	}
	.nav-links a {
		font-size: 0.88em;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.15s ease;
	}
	.nav-links a:hover, .nav-links a.active {
		color: var(--text);
	}
	.social { display: flex; align-items: center; }
</style>
