---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE, SITE_AUTHOR } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	type?: 'website' | 'article';
	pubDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website', pubDate } = Astro.props;
const ogImageUrl = image ? new URL(image.src, Astro.site) : new URL('/og-default.png', Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
{type === 'article' && pubDate && (
	<meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === 'article' && (
	<meta property="article:author" content="https://www.linkedin.com/in/janisr/" />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Structured Data -->
{type === 'website' ? (
<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebSite",
	"name": SITE_TITLE,
	"url": Astro.site,
	"author": {
		"@type": "Person",
		"name": SITE_AUTHOR,
		"url": "https://www.linkedin.com/in/janisr/"
	}
})} />
) : (
<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"description": description,
	"url": canonicalURL,
	"image": ogImageUrl.toString(),
	"datePublished": pubDate?.toISOString(),
	"author": {
		"@type": "Person",
		"name": SITE_AUTHOR,
		"url": "https://www.linkedin.com/in/janisr/"
	},
	"publisher": {
		"@type": "Organization",
		"name": SITE_TITLE,
		"url": Astro.site
	}
})} />
)}

<!-- Umami Analytics -->
<script defer src="https://stats.principal.house/script.js" data-website-id="181a41f9-c01b-4a54-a440-3ccfcda8a07a"></script>
